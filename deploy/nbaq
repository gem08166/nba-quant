#!/usr/bin/env bash
# nbaq —— nba-quant 常驻服务控制脚本（Linux / 云主机）
# 用法：deploy/nbaq {start|stop|restart|status|logs}
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PY="$ROOT/.venv/bin/python"
RUN_DIR="$ROOT/data/run"
LOG_DIR="$ROOT/data/log"
PIDFILE="$RUN_DIR/serve.pid"
LOG="$LOG_DIR/serve.log"
HOST="${NBAQ_HOST:-0.0.0.0}"
PORT="${NBAQ_PORT:-8000}"

mkdir -p "$RUN_DIR" "$LOG_DIR"

running() {
  [[ -f "$PIDFILE" ]] || return 1
  local pid
  pid=$(cat "$PIDFILE" 2>/dev/null || true)
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

wait_ready() {
  for _ in $(seq 1 30); do
    if curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:${PORT}/api/health" 2>/dev/null; then
      return 0
    fi
    sleep 1
  done
  return 1
}

start() {
  if running; then
    echo "already running (pid $(cat "$PIDFILE"))"
    return 0
  fi
  cd "$ROOT"
  setsid nohup "$PY" -m app.cli serve --host "$HOST" --port "$PORT" \
    >> "$LOG" 2>&1 < /dev/null &
  echo $! > "$PIDFILE"
  if wait_ready; then
    echo "started pid $(cat "$PIDFILE") on ${HOST}:${PORT}"
  else
    echo "start failed, see $LOG" >&2
    tail -n 20 "$LOG" >&2 || true
    return 1
  fi
}

stop() {
  if ! running; then
    echo "not running"
    rm -f "$PIDFILE"
    return 0
  fi
  local pid
  pid=$(cat "$PIDFILE")
  kill -TERM "$pid" 2>/dev/null || true
  for _ in $(seq 1 10); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$PIDFILE"
  echo "stopped"
}

status() {
  if running; then
    local pid
    pid=$(cat "$PIDFILE")
    echo "running pid=$pid port=$PORT"
    curl -fsS --max-time 3 "http://127.0.0.1:${PORT}/api/health" || echo "(health check failed)"
    echo
  else
    echo "stopped"
    return 1
  fi
}

case "${1:-status}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  logs) tail -n "${2:-80}" "$LOG" ;;
  *) echo "usage: $0 {start|stop|restart|status|logs}" >&2; exit 2 ;;
esac
