# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# 数据与运行时产物（Actions 云端计算的基底 + 静态站数据随仓库走）
# 注意：用 /* 而不是 data/，否则子文件例外不生效
# nba.db 不进主仓：由 Actions 持久化到独立的 data 分支（见 refresh.yml）
data/*
!data/player_zh.json
!data/backup/
data/backup/*
!data/backup/.gitkeep
*.log
tmp_*.py

# 环境与 IDE
.env
.idea/
.vscode/

# 手机壳（Capacitor）构建产物
mobile/node_modules/
mobile/www/
mobile/android/
mobile/*.apk

# 会话导出 / 本地杂项（不要进仓库）
ses_*.json
/nba-quant-20261103/
tmp_status.py

# 静态站产物（由云主机发布到 gh-pages 分支，不再进 main）
site/

# 坚果云同步临时文件
*.nssyncsc
mobile/screen*.png
mobile/build.log
deploy/*.png
